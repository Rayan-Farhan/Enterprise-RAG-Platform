# ==============================================================================
# Enterprise Multimodal RAG Platform — Environment Configuration Template
# ==============================================================================

# Core Application Settings
APP_NAME="Enterprise Multimodal RAG Platform"
APP_VERSION="0.1.0"
APP_ENV="development"              # development | testing | staging | production
DEBUG=false
API_V1_PREFIX="/api/v1"
SECRET_KEY="dev-insecure-secret-key-change-in-production"

# Inference Profile (ADR-051)
# hosted = Free-tier hosted APIs (Gemini, Groq, Jina) - Dev default
# local  = Local vLLM + TEI servers (satisfies ADR-045 enterprise privacy)
INFERENCE_PROFILE="hosted"

# PostgreSQL Database (ADR-002)
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="enterprise_rag"
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=10

# Redis Cache & Locks (ADR-020, ADR-039)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# RabbitMQ Task Broker (ADR-017)
RABBITMQ_HOST="localhost"
RABBITMQ_PORT=5672
RABBITMQ_USER="guest"
RABBITMQ_PASSWORD="guest"

# MinIO S3 Object Storage (ADR-003)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_SECURE=false
MINIO_BUCKET_NAME="enterprise-rag-documents"

# Qdrant Vector Database (ADR-007)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_COLLECTION_NAME="enterprise_rag_chunks"

# OpenSearch Lexical & Neural Sparse Engine (ADR-007, ADR-008)
OPENSEARCH_HOST="localhost"
OPENSEARCH_PORT=9200
OPENSEARCH_USER="admin"
OPENSEARCH_PASSWORD="admin"
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false
OPENSEARCH_INDEX_NAME="enterprise_rag_chunks"

# Hosted Model Providers (Free API Keys) - Required if INFERENCE_PROFILE=hosted
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"
GEMINI_VISION_MODEL="gemini-3.6-flash"

GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

JINA_API_KEY=""
JINA_EMBED_MODEL="jina-embeddings-v3"
JINA_RERANK_MODEL="jina-reranker-v2-base-multilingual"

# Local Inference Servers - Required if INFERENCE_PROFILE=local
VLLM_BASE_URL="http://localhost:8000/v1"
VLLM_MODEL="Qwen/Qwen2.5-7B-Instruct"
TEI_EMBED_BASE_URL="http://localhost:8080"
TEI_RERANK_BASE_URL="http://localhost:8081"

# ---------------------------------------------------------------------------
# Chunking (Stage 3 baseline, ADR-006, ADR-036)
# ---------------------------------------------------------------------------
CHUNKING_STRATEGY="fixed"          # Stage 3 locks 'fixed'; Stage 5 adds structure_aware/hierarchical/contextual
CHUNKING_VERSION="fixed-v2"        # Participates in deterministic chunk IDs; bump to force re-chunking
CHUNK_SIZE_TOKENS=512              # Target chunk size; parameters become benchmark-driven in Stage 5
CHUNK_OVERLAP_TOKENS=64            # Must be smaller than CHUNK_SIZE_TOKENS

# ---------------------------------------------------------------------------
# Embedding & Indexing (Stage 3, ADR-009, ADR-036)
# ---------------------------------------------------------------------------
EMBEDDING_VERSION="jina-embeddings-v3"  # Participates in deterministic point IDs; bump to force re-embedding
EMBEDDING_DIMENSIONS=1024          # Collection is created with the dimensionality the provider returns
EMBEDDING_BATCH_SIZE=32            # Texts per provider call
EMBEDDING_MAX_RPM=60               # Free-tier requests/minute ceiling; exceeding it slows, never fails, the job
EMBEDDING_MAX_RETRIES=5            # Bounded retry with jittered backoff

# ---------------------------------------------------------------------------
# Dense Retrieval (Stage 3, ADR-007)
# ---------------------------------------------------------------------------
RETRIEVAL_TOP_K=8                  # Chunks returned per query
RETRIEVAL_CANDIDATE_LIMIT=50       # Candidate pool (used by Stage 6 fusion/reranking)
RETRIEVAL_MIN_SCORE=0.35           # PROVISIONAL floor (in-corpus 0.48-0.59 vs off-corpus 0.24-0.29); Stage 4 sets this by experiment

# ---------------------------------------------------------------------------
# Generation & Grounding (Stage 3, ADR-024, ADR-025, ADR-047)
# ---------------------------------------------------------------------------
GENERATION_MAX_CONTEXT_TOKENS=6000 # Evidence budget for assembled context
GENERATION_TEMPERATURE=0.1         # Low by design: grounded answering, not creativity
GENERATION_MAX_TOKENS=1500
PROMPT_VERSION_ANSWER="answer_v1"       # Versioned artifact in app/generation/prompts/templates/
PROMPT_VERSION_ABSTENTION="abstention_v1"
PROMPT_VERSION_CITATION="citation_v1"
ABSTENTION_MIN_EVIDENCE_CHUNKS=1   # Below this many retrieved chunks, the system abstains

# Feature Flags (Master Plan §2 - Disabled by default until validated by experiment)
ENABLE_RERANKING=false
ENABLE_VISUAL_RETRIEVAL=false
ENABLE_QUERY_DECOMPOSITION=false
ENABLE_MULTI_HOP=false
ENABLE_SEMANTIC_CACHE=false

# Security & Limits (ADR-021, ADR-022)
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_SIZE_MB=100
